# --- Public site URL ---------------------------------------------------------
# Production domain (no trailing slash). Used for metadataBase, canonical URLs,
# sitemap.xml, robots.txt, JSON-LD structured data, and Open Graph image URLs.
# Set this once the real domain is registered.
NEXT_PUBLIC_SITE_URL=https://calegaldocumenthelp.com

# --- Google Search Console verification --------------------------------------
# Paste only the `content` value from the meta tag Google gives you:
#   <meta name="google-site-verification" content="THIS_VALUE" />
# Leave blank until you verify the property in Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google Analytics 4 ------------------------------------------------------
# GA4 Measurement ID (starts with "G-"). Found in GA Admin → Data Streams →
# your web stream. When set, GA4 loads site-wide and a `generate_lead` event
# fires on successful intake submissions. Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# --- Meta (Facebook) Pixel + Conversions API ---------------------------------
# Pixel/Dataset ID from Meta Events Manager. When set, the browser pixel loads
# site-wide and a "Lead" event fires on successful intake submissions.
NEXT_PUBLIC_FB_PIXEL_ID=990474967199592

# Conversions API access token (server-side only — never expose as
# NEXT_PUBLIC). Generate in Events Manager → your dataset → Settings →
# Conversions API → Generate access token. When set, the server also sends
# each Lead directly to Meta (survives iOS/Safari pixel blocking); it is
# deduplicated against the browser event via a shared event_id.
META_CAPI_ACCESS_TOKEN=

# Test Events code from Events Manager → Test events tab (looks like
# "TEST12345"). Set temporarily so server events appear in the Test events
# tab for verification. REMOVE in production or events won't count.
META_CAPI_TEST_EVENT_CODE=

# --- GoHighLevel webhook (server-side only) ----------------------------------
# When set, intake form submissions POST to this URL.
# When unset, submissions are logged locally and the form still succeeds.
GHL_FORM_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_WEBHOOK_ID/webhook-trigger/YOUR_TRIGGER_ID

# --- Google Ads lead-form webhook (server-side only) -------------------------
# Shared secret that authenticates POSTs from a Google Ads lead form to
# /api/google-lead-webhook. Set the SAME value here and in Google Ads
# (lead form → Lead delivery → Webhook → "Key"). Ad leads are then emailed to
# INTAKE_EMAIL_TO through the same path as website intake leads. Until this is
# set, the webhook rejects all calls (fail closed). Pick a long random string.
GOOGLE_LEAD_WEBHOOK_KEY=
