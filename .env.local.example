# --- Public site URL ---------------------------------------------------------
# Production domain (no trailing slash). Used for metadataBase, canonical URLs,
# sitemap.xml, robots.txt, JSON-LD structured data, and Open Graph image URLs.
# Set this once the real domain is registered.
NEXT_PUBLIC_SITE_URL=https://californialegaldocs.com

# --- Google Search Console verification --------------------------------------
# Paste only the `content` value from the meta tag Google gives you:
#   <meta name="google-site-verification" content="THIS_VALUE" />
# Leave blank until you verify the property in Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- GoHighLevel webhook (server-side only) ----------------------------------
# When set, intake form submissions POST to this URL.
# When unset, submissions are logged locally and the form still succeeds.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_WEBHOOK_ID/webhook-trigger/YOUR_TRIGGER_ID
